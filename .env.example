# Optional overrides — simplesat-mcp has no required env vars.
# Authentication is per-request via one request header, matching MSPbots'
# own stored credential field for this integration (SimpleSAT V1):
#   X-Simplesat-Api-Key — the Simplesat API key (generated under
#     Account Settings -> API Keys), forwarded as-is to the vendor's own
#     "X-Simplesat-Token" header on every call. No login/token exchange.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
